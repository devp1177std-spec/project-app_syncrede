# Application Environment Variables Example

# ==========================================
# GENERAL / APP CONFIG
# ==========================================
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# ==========================================
# DATABASE (PostgreSQL)
# ==========================================
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5433/social_db?schema=public

# ==========================================
# CACHE & QUEUES (Redis)
# ==========================================
REDIS_URL=redis://localhost:6379

# ==========================================
# RATE LIMITING (Throttler)
# ==========================================
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ==========================================
# AUTHENTICATION (Firebase Authentication)
# ==========================================
# Firebase Client SDK (Exposed to browser via Next.js NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleKeyForLocalDev1234567890ab
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=social-media-app-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=social-media-app-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=social-media-app-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
# Optional: Local Firebase Auth Emulator host (uncomment when using emulator)
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Firebase Admin SDK (Server-Side Only - Private Credentials)
FIREBASE_PROJECT_ID=social-media-app-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@social-media-app-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=""

# ==========================================
# STORAGE (Local MinIO or Cloudflare R2 / AWS S3)
# ==========================================
# Local MinIO defaults:
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadminpassword
STORAGE_BUCKET_NAME=social-media-assets
STORAGE_PUBLIC_URL=http://localhost:9000/social-media-assets
STORAGE_FORCE_PATH_STYLE=true

# Cloudflare R2 production settings (uncomment to use R2):
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=social-media-assets
# R2_PUBLIC_URL=https://cdn.yourdomain.com

# ==========================================
# SEARCH (OpenSearch)
# ==========================================
OPENSEARCH_NODE=http://localhost:9200

# ==========================================
# PUSH NOTIFICATIONS (Web Push & FCM)
# ==========================================
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@yourdomain.com
FIREBASE_SERVICE_ACCOUNT_KEY={}
